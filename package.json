{
  "name": "tweakr",
  "version": "1.0.2",
  "description": "Windows Performance Tool",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.7",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^6.0.0",
    "javascript-obfuscator": "^4.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.tweakr.app",
    "productName": "Tweakr",
    "asar": true,
    "directories": {
      "output": "versions"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
