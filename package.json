{
  "name": "tweakr",
  "version": "1.0.1",
  "description": "Windows gaming performance tool",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish always"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.1.0"
  },
  "build": {
    "appId": "com.tweakr.app",
    "productName": "Tweakr",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}